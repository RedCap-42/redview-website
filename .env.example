# Public site URL — canonical origin used by metadataBase, sitemap, robots,
# OG/Twitter card URLs. No trailing slash.
NEXT_PUBLIC_WEBSITE_URL=

# Public app URL — where the RedView 3D viewer actually lives. Used by the
# site's "Open the app" calls to action.
NEXT_PUBLIC_APP_URL=

# Feedback — the feedback form POSTs to /api/feedback, which sends the message
# through Resend to the recipient below.
RESEND_API_KEY=
RESEND_FROM=
FEEDBACK_RECIPIENT_EMAIL=

# Partner application — the form POSTs to /api/partner-application, which
# forwards the payload to this webhook with the secret as a bearer credential.
PARTNER_APPLICATION_WEBHOOK_URL=
PARTNER_APPLICATION_SECRET=

# Client brief — the form POSTs to /api/client-brief, which forwards the payload
# to this webhook with the secret as X-Application-Secret.
CLIENT_BRIEF_WEBHOOK_URL=
CLIENT_BRIEF_SECRET=

# Partners directory — REST endpoint the partner directory reads from
# server-side. Leave unset to render the empty directory.
REDVIEW_PARTNERS_API_URL=
REDVIEW_PARTNERS_API_KEY=

# Apps directory — GraphQL endpoint the apps directory reads from
# server-side. Leave unset to render the empty directory.
REDVIEW_MARKETPLACE_API_URL=
